# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="Adaptive News Discovery"
APP_VERSION="0.1.0"
DEBUG=True

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite path (relative to backend/ directory when running uvicorn)
DATABASE_URL="sqlite+aiosqlite:///./data/news_discovery.db"

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ── News API (Phase 2) ────────────────────────────────────────────────────────
# Register at https://newsapi.org/ and paste your key here
NEWS_API_KEY=""
